# --- On the Railway service (Variables tab) ---
# Reference the Postgres service's URL; don't paste the password in.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PACER_BASE_ADMIN_TOKEN=
# Optional: name prefix for client databases (default pb_, so S&S -> pb_s_and_s)
# PACER_BASE_CLIENT_DB_PREFIX=pb_

# --- On your laptop, for the pacer-base admin commands ---
# PACER_BASE_URL=https://<your-service>.up.railway.app
# PACER_BASE_TOKEN=<the admin token, or a write token>
